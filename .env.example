# Get this from Vercel: Storage tab -> Marketplace Database Storage ->
# add Neon integration -> it injects this automatically once linked, but
# you need it locally too for `npm run db:migrate` / `db:seed` / dev.
#
# Use the POOLED connection string specifically — in the Neon dashboard
# this is the one with "-pooler" in the hostname (Vercel's auto-injected
# version is already the pooled one). This app uses transactions
# (invoice creation, inventory stock updates), which need a connection
# string that supports them properly under serverless — the pooled
# endpoint is what makes that work without exhausting Postgres's
# connection limit as multiple function instances spin up.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"

# A long, random string used to sign session tokens. Generate one with:
#   openssl rand -base64 48
# Never reuse the marketing site's SESSION secret for this — a leak of
# one should not compromise the other.
SESSION_SECRET="replace-with-a-long-random-string"

# Set to your production URL once deployed (used for cookie settings).
NODE_ENV="development"
